# BASELINE PACKAGES
# Minimal package set defining a basic Arch Linux installation environment
base

# Integration services and drivers for Hyper-V virtual machines
hyperv

# The Linux kernel and modules
linux

# Modular initramfs image creation tool for Arch Linux
mkinitcpio

# Initramfs build hooks required for Archiso live images
mkinitcpio-archiso

# Open-source VMware Guest Services for VMware virtual machines
open-vm-tools

# Secure Shell tools for remote system access and secure file transfer
openssh

# Pipe Viewer tool to monitor data progress through a terminal pipeline
pv

# Guest agent for host-guest communication under QEMU/KVM hypervisors
qemu-guest-agent

# Lightweight bootloader suite for BIOS-based system startup
syslinux

# VirtualBox guest utilities and integration services without X11 GUI dependencies
virtualbox-guest-utils-nox


# INSTALLER 
# Guided and interactive Arch Linux installer script
archinstall

# Install baseline script for archinstall
arch-install-scripts

# Official Arch Linux GPG keyring containing public keys for package verification
archlinux-keyring


# FILESYSTEMS & DISK ENCRYPTION
# Provides mkfs.fat and fsck.fat. Essential for formatting the EFI system partition (/boot) as FAT32 on any UEFI system.
dosfstools

# Provides mkfs.ext4, e2fsck, and resize2fs for managing standard Linux ext4 partitions.
e2fsprogs

# Provides mkfs.btrfs and btrfs, which are required for formatting and managing Btrfs subvolumes (the default option for archinstall).
btrfs-progs

# Manages LUKS (dm-crypt) disk encryption, which protects the target system's partitions against unauthorized physical access.
cryptsetup


# MINIMAL WIFI & HARDWARE FIRMWARE
# iNet Wireless Daemon: a modern, lightweight Wi-Fi daemon that directly uses the Linux kernel's cryptographic primitives
iwd

# All binary firmware required by network controllers and physical Wi-Fi cards
linux-firmware

# Regulatory database of radio frequencies, essential for unlocking 5 GHz Wi-Fi channels
wireless-regdb

